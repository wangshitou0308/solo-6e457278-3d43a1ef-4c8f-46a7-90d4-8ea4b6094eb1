        "tags": [
          "samples"
        ],
        "summary": "示例 NDJSON 日志",
        "operationId": "get_sample_logs_api_v1_sample_logs_ndjson_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
