            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Sample Strategy Api V1 Sample Strategy Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sample/logs.ndjson": {
